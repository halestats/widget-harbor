# 先复制为 .env；至少 12 个字符。推荐用 python3 scripts/init_env.py 自动生成。
ADMIN_PASSWORD=change-me-at-least-12-characters
# 必须是客户端能够访问的完整站点地址，不带结尾路径；反向代理时填写 HTTPS 域名。
SITE_URL=http://localhost:8765
# 默认只供本机反向代理连接。局域网访问可改为 NAS 的局域网 IP 或 0.0.0.0。
BIND_ADDRESS=127.0.0.1
HOST_PORT=8765

# Extra trusted management origins, comma-separated
ALLOWED_ORIGINS=
